# The training image: the one jobs image. It runs the base project's training code, unchanged, as a SageMaker
# training job, and the course's processing entrypoints as SageMaker processing jobs.
#
# Why our own container: the newest built-in scikit-learn image is 1.9.0 on Python 3.12.
# The base project's model was trained with scikit-learn 1.8.0 on Python 3.14. A pickled model must load with
# the same scikit-learn it was saved with, so we ship our own container.
#
# The SageMaker contracts:
#   training     started as "docker run <image> train" (the train launcher below, on the PATH); it runs
#                m08_03_train_entrypoint.py: channel fe (+ channel config) in /opt/ml/input/data, the model
#                written to /opt/ml/model, a failure reason to /opt/ml/output/failure
#   processing   the job's own ContainerEntrypoint, for example ["python3", "/opt/program/m08_02_data_checks.py"]
#                (MLOps 08 data checks) or ["python3", "/opt/program/m13_03_evaluate_vs_champion.py"] (MLOps 13 gate)
# No data, no model and no config inside the image: they come from S3 through the job's channels.
#
# No USER line, on purpose: the same rule as Dockerfile.serving; training and processing jobs run this way
# and write /opt/ml/model and /opt/ml/output without a problem.
#
# Built on your EC2 VM and pushed to ECR as a Docker v2 manifest (MLOps 08), tagged sha-<7 characters of the commit>.

# python:3.14.8-slim, pinned by the digest of its multi-platform index; the same base as Dockerfile.serving
FROM python:3.14.8-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PATH="/opt/program:${PATH}"

WORKDIR /opt/program

# The lock first: a code change then does not reinstall the packages (layer cache).
# Wheels only, so nothing is compiled in the image. The lock holds mlflow 3.16.0 (the version of the
# MLflow App) and sagemaker-mlflow, so a job can log to the App when MLFLOW_TRACKING_URI is set.
# A job uses only MLflow's client calls. The full mlflow package also brings its tracking-server packages
# (Flask, gunicorn, SQLAlchemy, Alembic, pyarrow, matplotlib and more: about 285 MB of the 808 MB of Python
# packages); they ride along by choice, because the lock names the full mlflow 3.16.0.
COPY requirements-training.txt constraints-training.txt ./
RUN pip install --only-binary=:all: -r requirements-training.txt -c constraints-training.txt

# The base project's code, unchanged (the frozen copy): utils/, p4_01 (amount_ratio, run by the data checks),
# p5_02 (grid search), p5_03 (production training) and p5_04 (its TransactionRequest: the data checks' limits)
COPY utils/ ./utils/
COPY p4_01_feature_engineering_fe1.py p5_02_class_weight_gridsearch.py p5_03_train_production_model.py \
     p5_04_inference_api.py ./

# The course's shared code (config, the MLflow layer, the Net Benefit gate, the job helper) and the training entrypoint
COPY mlops_utils/ ./mlops_utils/
COPY m08_03_train_entrypoint.py ./

# The 2 processing entrypoints ride in this image too (one jobs image): the data checks + amount_ratio
# (MLOps 08) and the gate, candidate vs champion (MLOps 13)
COPY m08_02_data_checks.py m13_03_evaluate_vs_champion.py m15_03_drift_job.py ./

COPY --chmod=0755 train ./

# SageMaker replaces this with its own "train" argument, which runs the same launcher
CMD ["train"]
