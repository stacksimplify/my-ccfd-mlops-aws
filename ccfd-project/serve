#!/bin/sh
# The serve launcher. SageMaker starts the serving container as "docker run <image> serve";
# this file is that "serve" command (it is on the PATH in Dockerfile.serving).
# It starts the serving API m01_03_serving_api:app with uvicorn on 0.0.0.0:8080, one worker.
# The model folder comes from MODEL_DIR (/opt/ml/model in the image).
# It also runs from the ccfd-project folder: ./serve
set -e

APP_DIR=$(dirname "$0")

exec uvicorn m01_03_serving_api:app --host 0.0.0.0 --port 8080 --workers 1 --app-dir "$APP_DIR"
